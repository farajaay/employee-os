# Employee OS — client environment.
# Copy to .env for local development. Never commit .env.
#
# Only the Supabase *publishable* (anon) key belongs here. Row Level Security is the
# security boundary. A service-role key in a VITE_ variable is shipped to every user
# and is an immediate, total compromise of the database — never add one.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
